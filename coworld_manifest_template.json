{
  "tags": [
    "strategy",
    "diplomacy",
    "turn-based"
  ],
  "game": {
    "name": "webdiplomacy",
    "description": "Classic Diplomacy using the unmodified webDiplomacy server and its bot API.",
    "owner": "james@softmax.com",
    "player_runtime": "platform-hosted",
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "source_url": "https://github.com/Metta-AI/coworld-webdiplomacy/tree/main"
    },
    "config_schema": {
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "items": {
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Tokens",
          "type": "array"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "phase_minutes": {
          "default": 1,
          "maximum": 59,
          "minimum": 1,
          "title": "Phase Minutes",
          "type": "integer"
        },
        "retreat_build_minutes": {
          "default": 1,
          "maximum": 59,
          "minimum": 1,
          "title": "Retreat Build Minutes",
          "type": "integer"
        },
        "press": {
          "default": "NoPress",
          "enum": [
            "NoPress",
            "Regular"
          ],
          "title": "Press",
          "type": "string"
        },
        "anonymous": {
          "default": true,
          "title": "Anonymous",
          "type": "boolean"
        },
        "end_year": {
          "default": 1910,
          "maximum": 2000,
          "minimum": 1901,
          "title": "End Year",
          "type": "integer"
        },
        "scoring": {
          "default": "sum_of_squares",
          "enum": [
            "sum_of_squares",
            "draw_size",
            "supply_centers"
          ],
          "title": "Scoring",
          "type": "string"
        },
        "player_connect_timeout_seconds": {
          "default": 180,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Player Connect Timeout Seconds",
          "type": "number"
        },
        "episode_budget_seconds": {
          "default": 5910,
          "maximum": 5910,
          "minimum": 5,
          "title": "Episode Budget Seconds",
          "type": "number"
        },
        "completion_timeout_seconds": {
          "default": 20,
          "maximum": 20,
          "minimum": 0,
          "title": "Completion Timeout Seconds",
          "type": "number"
        },
        "render_maps": {
          "default": false,
          "title": "Render Maps",
          "type": "boolean"
        }
      },
      "required": [
        "tokens"
      ],
      "title": "EpisodeConfig",
      "type": "object"
    },
    "results_schema": {
      "type": "object",
      "required": [
        "scores",
        "outcome",
        "final_state"
      ],
      "properties": {
        "scores": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "number"
          }
        },
        "outcome": {
          "type": "string"
        },
        "final_state": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "protocols": {
      "player": {
        "type": "text",
        "value": "webdip-coworld/1: /player sends hello with the seat API key, game and country. Bots play directly through upstream api.php. Lifecycle messages are game_started and game_over; acknowledge completion with game_over_ack. Disconnects do not fail an episode."
      },
      "global": {
        "type": "text",
        "value": "The /global and /replay WebSockets expose public adjudicated game state and phase history. The /client/global and /client/replay routes provide a browser viewer."
      }
    },
    "docs": {
      "readme": {
        "type": "text",
        "value": "Development build: API bots and episode lifecycle. Browser play and complete replay presentation are under development."
      }
    }
  },
  "player": [
    {
      "id": "hold",
      "type": "player",
      "image": "{{PLAYER_IMAGE}}",
      "name": "Hold bot",
      "description": "Holds units and marks Ready using the upstream API.",
      "source_url": "https://github.com/Metta-AI/coworld-webdiplomacy/tree/main/players"
    }
  ],
  "variants": [
    {
      "id": "classic-gunboat",
      "name": "Classic gunboat",
      "description": "Classic NoPress with a 1910 year cap.",
      "game_config": {
        "end_year": 1910,
        "press": "NoPress"
      }
    }
  ],
  "certification": {
    "game_config": {
      "end_year": 1901,
      "player_connect_timeout_seconds": 20,
      "episode_budget_seconds": 45,
      "render_maps": false
    },
    "players": [
      {
        "player_id": "hold"
      },
      {
        "player_id": "hold"
      },
      {
        "player_id": "hold"
      },
      {
        "player_id": "hold"
      },
      {
        "player_id": "hold"
      },
      {
        "player_id": "hold"
      },
      {
        "player_id": "hold"
      }
    ]
  },
  "$schema": "https://raw.githubusercontent.com/Metta-AI/coworld/main/src/coworld/coworld_manifest_schema.json",
  "episode_timeout_minutes": 100,
  "players_per_user": 1
}
