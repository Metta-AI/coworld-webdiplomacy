#!/usr/bin/env python3
"""`ide/ide <command>`: the optimizer IDE's command line. See `ide/ide --help` and webdip_ide/cli.py."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from webdip_ide.cli import main  # noqa: E402

# The guard matters: the server's reader processes import this file again (`webdip_ide/reader.py`).
if __name__ == "__main__":
    sys.exit(main())
